    <string name="kojiki_shared_uid_title">uid %1$s · %2$d apps</string>
    <string name="kojiki_shared_uid_body">Android binds a firewall rule to the uid, not to the app. “%1$s” shares uid %2$s with the apps below, so this rule applies to every one of them — under this uid they cannot be ruled apart.</string>
