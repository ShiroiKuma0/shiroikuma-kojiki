<!-- 白い熊 考直: the apps view's sort affordance — three descending rules.

     Drawn with STROKES, never fills: every icon in this app pairs android:strokeColor with
     ?attr/svgStrokeColor and leaves android:fillColor at ?attr/svgFillColor, which the themes define
     as @android:color/transparent. A filled path is therefore invisible — and stays invisible under
     the Custom theme too, since CustomUi tints icons with setColorFilter (SRC_ATOP), which keeps the
     source alpha. Stroke weight 2 matches ic_refresh_white / ic_filter beside it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="?attr/svgFillColor"
        android:pathData="M4,7h16"
        android:strokeWidth="2"
        android:strokeColor="?attr/svgStrokeColor"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter" />
    <path
        android:fillColor="?attr/svgFillColor"
        android:pathData="M4,12h11"
        android:strokeWidth="2"
        android:strokeColor="?attr/svgStrokeColor"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter" />
    <path
        android:fillColor="?attr/svgFillColor"
        android:pathData="M4,17h6"
        android:strokeWidth="2"
        android:strokeColor="?attr/svgStrokeColor"
        android:strokeLineCap="square"
        android:strokeLineJoin="miter" />
</vector>
