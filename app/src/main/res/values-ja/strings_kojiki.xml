    <string name="kojiki_diag_stored_none">保存済み：なし</string>
    <string name="kojiki_diag_export">診断データをエクスポート</string>
    <string name="kojiki_diag_export_desc">選んだディレクトリの中に日付入りのサブディレクトリを新しく作り、すべてのファイルをそこへコピーします（前回：%1$s）。</string>
    <string name="kojiki_diag_export_done">%1$d 個のファイルを %2$s にエクスポートしました</string>
    <string name="kojiki_diag_export_failed">エクスポートに失敗しました：%1$s</string>
    <string name="kojiki_diag_purge">診断データを完全に削除</string>
    <string name="kojiki_diag_purge_desc">保存されている記録ファイルとヒープダンプをすべて削除します。その前に、一覧を示す警告が出ます。</string>
