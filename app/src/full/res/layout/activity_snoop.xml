<?xml version="1.0" encoding="utf-8"?>
<!-- Fork (白い熊 考直) — Snooping panel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/snoop_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/background"
    android:orientation="vertical">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/snoop_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="15dp"
        android:fontFamily="sans-serif-light"
        android:text="@string/snoop_title"
        android:textColor="?attr/primaryTextColor"
        android:textSize="@dimen/heading_font_text_view"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        app:cardCornerRadius="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.SearchView
                android:id="@+id/snoop_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/snoop_sort"
                android:fontFamily="sans-serif"
                app:iconifiedByDefault="false"
                app:queryHint="@string/snoop_search_hint" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/snoop_sort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/snoop_filter_icon"
                android:background="?android:attr/selectableItemBackground"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/snoop_sort_newest"
                android:textColor="?attr/accentGood"
                android:textSize="@dimen/default_font_text_view" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/snoop_filter_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/snoop_delete_icon"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/snoop_filter_cd"
                android:padding="9dp"
                android:src="@drawable/ic_filter" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/snoop_delete_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/snoop_clear_all"
                android:padding="9dp"
                android:src="@drawable/ic_delete" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/snoop_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:gravity="center"
        android:padding="10dp"
        android:text="@string/snoop_empty"
        android:textColor="?attr/primaryLightColorText"
        android:textSize="@dimen/large_font_text_view"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/snoop_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="3dp"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="true"
        android:orientation="vertical" />

</LinearLayout>
