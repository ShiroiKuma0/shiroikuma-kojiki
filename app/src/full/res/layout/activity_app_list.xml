<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/background"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <LinearLayout
        android:id="@+id/ffa_search_view_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <androidx.appcompat.widget.SearchView
                        android:id="@+id/ffa_search"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:layout_weight="0.7"
                        android:fontFamily="sans-serif"
                        android:focusable="false"
                        android:isScrollContainer="true"
                        app:iconifiedByDefault="false"
                        app:queryHint="@string/search_firewall_all_apps" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ffa_refresh_list"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_weight="0.1"
                        android:padding="7dp"
                        android:src="@drawable/ic_refresh_white" />

                    <!-- Fork (白い熊 考直): the sort affordance. It sits beside the filter icon rather
                         than inside the filter sheet: the sheet's chip sections already fill it to
                         the edge of a folded screen, and sort is a one-tap decision, not a
                         multi-select. The search field gives up the 0.1 weight this takes. -->
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ffa_sort_icon"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_weight="0.1"
                        android:contentDescription="@string/kojiki_sort_content_desc"
                        android:padding="7dp"
                        android:src="@drawable/ic_kojiki_sort" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ffa_filter_icon"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_weight="0.1"
                        android:padding="7dp"
                        android:src="@drawable/ic_filter"
                        android:visibility="visible" />
                </LinearLayout>

                <!-- Fork (白い熊 考直): the quick-filter bar. A RecyclerView, not upstream's
                     ChipGroup inside a HorizontalScrollView: the row is heterogeneous now (firewall,
                     top-level, category, group and "has a note" pills all share it), so ChipGroup's
                     single-selection is wrong, and drag-reordering needs an ItemTouchHelper, which
                     attaches to a RecyclerView. It scrolls itself — nesting it in the old
                     HorizontalScrollView would have left two horizontal scrollers fighting. -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/ffa_firewall_chip_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:clipToPadding="false"
                    android:paddingTop="10dp"
                    android:paddingBottom="5dp"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/firewall_app_label_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginBottom="5dp"
                    android:ellipsize="marquee"
                    android:fontFamily="sans-serif"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:maxLines="1"
                    android:padding="5dp"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:text="@string/fapps_firewall_filter_hint"
                    android:textAlignment="textStart"
                    android:textSize="@dimen/default_font_text_view" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/ffa_toggle_all_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/ffa_search_view_top"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ffa_app_info_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:alpha="0.5"
            android:src="@drawable/ic_info_white" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ffa_toggle_all_lockdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:layout_toStartOf="@id/ffa_toggle_all_exclude"
            android:maxWidth="24dp"
            android:maxHeight="24dp"
            android:padding="5dp"
            android:src="@drawable/ic_firewall_lockdown_off"
            android:tag="0" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ffa_toggle_all_exclude"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:layout_toStartOf="@id/ffa_toggle_all_bypass"
            android:maxWidth="24dp"
            android:maxHeight="24dp"
            android:padding="5dp"
            android:src="@drawable/ic_firewall_exclude_off"
            android:tag="0" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ffa_toggle_all_bypass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:layout_toStartOf="@id/ffa_toggle_all_bypass_dns_firewall"
            android:maxWidth="24dp"
            android:maxHeight="24dp"
            android:padding="5dp"
            android:src="@drawable/ic_firewall_bypass_off"
            android:tag="0" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ffa_toggle_all_bypass_dns_firewall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:layout_toStartOf="@id/ffa_toggle_all_wifi"
            android:maxWidth="24dp"
            android:maxHeight="24dp"
            android:padding="5dp"
            android:src="@drawable/ic_bypass_dns_firewall_off"
            android:tag="0" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ffa_toggle_all_wifi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:layout_toStartOf="@id/ffa_toggle_all_mobile_data"
            android:maxWidth="24dp"
            android:maxHeight="24dp"
            android:padding="5dp"
            android:src="@drawable/ic_firewall_wifi_on_grey"
            android:tag="0" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ffa_toggle_all_mobile_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:maxWidth="24dp"
            android:maxHeight="24dp"
            android:padding="5dp"
            android:src="@drawable/ic_firewall_data_on_grey"
            android:tag="0" />

    </RelativeLayout>

    <com.simplecityapps.recyclerview_fastscroll.views.FastScrollRecyclerView
        android:id="@+id/ffa_app_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/ffa_toggle_all_container"
        android:layout_marginStart="2dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        android:layout_marginBottom="2dp"
        android:clickable="true"
        android:focusable="true"
        app:fastScrollPopupTextColor="?attr/primaryLightColorText"
        app:fastScrollPopupBgColor="?attr/background"
        app:fastScrollEnabled="false"
        app:fastScrollHorizontalThumbDrawable="@drawable/fast_scroll_thumb_drawable"
        app:fastScrollHorizontalTrackDrawable="@drawable/fast_scroll_line_drawable"
        app:fastScrollVerticalThumbDrawable="@drawable/fast_scroll_thumb_drawable"
        app:fastScrollVerticalTrackDrawable="@drawable/fast_scroll_line_drawable"
        app:fastScrollAutoHide="true"
        app:fastScrollAutoHideDelay="1500"
        app:fastScrollEnableThumbInactiveColor="true"
        app:fastScrollThumbColor="?attr/chipColorBgNormal"
        app:fastScrollThumbEnabled="true"
        app:fastScrollThumbInactiveColor="?attr/chipColorBgNormal"
        app:fastScrollTrackColor="?attr/background" />

</RelativeLayout>
