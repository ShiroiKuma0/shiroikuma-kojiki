<?xml version="1.0" encoding="utf-8"?>
<!-- Fork (白い熊 考直): the network-log row, packed into two tight lines (0.5.8+022).
       line 1:  time · domain (or ip:port when there is no name) · protocol pill · flag
       line 2:  [BLOCKED tag] app · ip:port · data up/down · duration · hints
     Every id upstream's adapters bind is still here, with the same view type, so the three adapters
     (ConnectionTrackerAdapter, ConnectionLogAdapter, RethinkLogAdapter) compile untouched; what goes
     where is decided by CustomUi.packConnLogRow / applyConnLogRow at bind time. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/connection_parent_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/connection_status_indicator"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="?attr/colorError" />

        <ImageView
            android:id="@+id/connection_app_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/apps_icon_content_desc"
            android:src="@drawable/default_app_icon" />

        <LinearLayout
            android:id="@+id/connection_screen_ll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp">

            <LinearLayout
                android:id="@+id/connection_name_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/connection_response_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="?attr/primaryLightColorText"
                    android:textSize="@dimen/default_font_text_view"
                    tools:text="12:44:28" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/connection_domain"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:includeFontPadding="false"
                    android:paddingStart="8dp"
                    android:paddingEnd="6dp"
                    android:singleLine="true"
                    android:textColor="?attr/primaryTextColor"
                    android:textSize="@dimen/large_font_text_view"
                    tools:text="supl.platform.dbankcloud.cn" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/conn_latency_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/drawable_purple_gradient"
                    android:includeFontPadding="false"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1dp"
                    android:singleLine="true"
                    android:textSize="@dimen/mini_font_text_view"
                    android:textStyle="bold"
                    tools:text="TCP" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/connection_flag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="none"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="22dp"
                    android:paddingStart="6dp"
                    android:singleLine="true"
                    android:textSize="15sp"
                    tools:text="" />

                <!-- upstream's expand chevron: pure decoration (the whole row opens the details
                     sheet), and it cost a column. Kept for the binding, never shown. -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_keyboard_arrow_down"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/connection_info_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- BLOCKED / ALLOWED tag, shown only when enabled in the 白い熊 考直 UI. -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/connection_block_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:paddingEnd="6dp"
                    android:singleLine="true"
                    android:textSize="@dimen/mini_font_text_view"
                    android:visibility="gone"
                    tools:text="BLOCKED" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/connection_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:textColor="?attr/primaryLightColorText"
                    android:textSize="@dimen/default_font_text_view"
                    tools:text="GPS" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/connection_ip_address"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:paddingStart="8dp"
                    android:paddingEnd="6dp"
                    android:singleLine="true"
                    android:textColor="?attr/primaryLightColorText"
                    android:textSize="@dimen/default_font_text_view"
                    tools:text="80.158.109.4:7275" />

                <LinearLayout
                    android:id="@+id/connection_summary_ll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/connection_data_usage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="?attr/primaryLightColorText"
                        android:textSize="@dimen/default_font_text_view"
                        tools:text="271 B / 15.7 KB" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/connection_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:paddingStart="8dp"
                        android:singleLine="true"
                        android:textColor="?attr/primaryLightColorText"
                        android:textSize="@dimen/default_font_text_view"
                        tools:text="5 sec" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/connection_delay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:paddingStart="6dp"
                        android:singleLine="true"
                        android:textColor="?attr/primaryTextColor"
                        android:textSize="@dimen/default_font_text_view" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/connection_divider"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="?attr/divider" />
</LinearLayout>
