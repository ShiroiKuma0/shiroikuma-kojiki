<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Rethink.MaterialCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:minHeight="72dp">

        <!-- Fork (白い熊 考直): height is wrap_content, NOT 0dp. With 0dp the block is sized by the
             parent (whose wrap_content height then comes only from the 48dp toggles + minHeight
             72dp), so any text taller than 72dp — the note/group glyph line plus the group pills —
             is silently clipped. wrap_content lets the row grow to its content instead. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/firewall_app_details_ll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/firewall_app_toggle_wifi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/firewall_app_icon_iv"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/apps_icon_content_desc"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@drawable/default_app_icon" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/firewall_app_text_ll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/firewall_app_icon_iv"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Fork (白い熊 考直): the label line = app label · note glyph · note text, as one
                     chain. With a note, the label keeps its natural width so the glyph sits right
                     after it and the note's text fills the rest of the line (one line, ellipsized);
                     with no note the adapter switches the label to match_constraint, which pushes
                     the dim "+" out to the right edge. `layout_constrainedWidth` is what lets a long
                     app label ellipsize instead of shoving the glyph off the row. -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/firewall_app_label_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/firewall_app_note_pill"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintHorizontal_chainStyle="spread_inside"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="App Name" />

                    <!-- The note affordance is ONE pill in both states, tagged out of the CustomUi
                         restyle walk so its deliberately low-alpha border/text survive. With no note
                         it holds just the "+" glyph and the adapter pins it to the right edge with
                         the same end margin as the group "+" pill, so the two line up exactly. -->
                    <LinearLayout
                        android:id="@+id/firewall_app_note_pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="4dp"
                        android:gravity="center"
                        android:minWidth="26dp"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:tag="kojiki_no_restyle"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/firewall_app_label_tv"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/firewall_app_note_iv"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@string/kojiki_note"
                            app:srcCompat="@drawable/ic_kojiki_note_add" />

                        <!-- The note's own text, shown only when there is one. The empty state is the
                             glyph alone (its plus is drawn large enough to read as an add control),
                             so nothing sits here. -->
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/firewall_app_note_tv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="11sp"
                            android:visibility="gone"
                            tools:text="do not block — breaks login"
                            tools:visibility="visible" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/firewall_app_toggle_other"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textStyle="italic"
                    tools:text="Firewall status" />

                <!-- Fork (白い熊 考直): the traffic counter and the group (profile) pills SHARE this
                     line — the pills must not cost the row a fourth line. The counter takes only the
                     width it needs; the pill strip takes all the rest and right-aligns its content
                     (fillViewport + gravity="end"), so the pills and the trailing "+" sit hard
                     against the row's right edge and scroll sideways when there are many of them.
                     応用管理's format: one pill per group, then "+". Tap a pill = filter the list to
                     that group, long-press = drop the app from it; tap "+" = the membership
                     checklist, long-press "+" = manage the group list. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/firewall_app_data_usage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="10 MB 🔺 / 20 MB 🔻" />

                    <HorizontalScrollView
                        android:id="@+id/firewall_app_groups_sv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fillViewport="true"
                        android:scrollbars="none"
                        android:tag="kojiki_no_restyle">

                        <LinearLayout
                            android:id="@+id/firewall_app_groups_ll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end|center_vertical"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/firewall_app_toggle_wifi"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_firewall_action_outlined"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/firewall_app_toggle_mobile_data"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_firewall_wifi_on" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/firewall_app_toggle_mobile_data"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_firewall_action_outlined"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_firewall_data_on" />

        <!-- Fork (白い熊 考直): the configurable row divider (CustomUi.applyFirewallRow themes its
             colour/thickness). Upstream moved this row from a LinearLayout to a card+ConstraintLayout,
             so the divider is now pinned to the bottom edge instead of being a trailing sibling. -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/firewall_app_divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="?attr/divider"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
