<?xml version="1.0" encoding="utf-8"?>
<!-- Fork (白い熊 考直): the DNS-log row, packed into two tight lines (0.5.8+022).
       line 1:  time · name asked · resolver pill · flag / favicon
       line 2:  [BLOCKED tag] app · record type · answer · latency · hints
     Every id upstream's DnsLogAdapter binds is still here with the same view type; the styling is
     CustomUi.applyDnsLogRow at bind time. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/dns_parent_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/dns_status_indicator"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="?attr/colorError" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/dns_app_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/apps_icon_content_desc"
            android:src="@drawable/ic_about" />

        <LinearLayout
            android:id="@+id/dns_screen_ll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp">

            <LinearLayout
                android:id="@+id/dns_type_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/dns_wall_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="?attr/primaryLightColorText"
                    android:textSize="@dimen/default_font_text_view"
                    tools:text="12:44:38" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/dns_query"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:includeFontPadding="false"
                    android:paddingStart="8dp"
                    android:paddingEnd="6dp"
                    android:singleLine="true"
                    android:textColor="?attr/primaryTextColor"
                    android:textSize="@dimen/large_font_text_view"
                    tools:text="supl.platform.dbankcloud.cn" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/dns_type_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/drawable_purple_gradient"
                    android:includeFontPadding="false"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1dp"
                    android:singleLine="true"
                    android:textSize="@dimen/mini_font_text_view"
                    android:textStyle="bold"
                    tools:text="DoH" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/dns_flag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="none"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:minWidth="22dp"
                    android:paddingStart="6dp"
                    android:singleLine="true"
                    android:textSize="15sp"
                    tools:text="" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/dns_fav_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/apps_icon_content_desc"
                    android:src="@drawable/ic_about"
                    android:visibility="gone" />

                <!-- upstream's expand chevron: decoration only. Kept for the binding, never shown. -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/dns_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_keyboard_arrow_down"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dns_info_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- BLOCKED / MAYBE / ALLOWED tag, shown only when enabled in the 白い熊 考直 UI. -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/dns_block_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:paddingEnd="6dp"
                    android:singleLine="true"
                    android:textSize="@dimen/mini_font_text_view"
                    android:visibility="gone"
                    tools:text="BLOCKED" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/dns_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:textColor="?attr/primaryLightColorText"
                    android:textSize="@dimen/default_font_text_view"
                    tools:text="GPS" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/dns_query_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:paddingStart="8dp"
                    android:singleLine="true"
                    android:textColor="?attr/primaryLightColorText"
                    android:textSize="@dimen/default_font_text_view"
                    tools:text="IPv4" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/dns_ips"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:paddingStart="8dp"
                    android:paddingEnd="6dp"
                    android:singleLine="true"
                    android:textColor="?attr/primaryLightColorText"
                    android:textSize="@dimen/default_font_text_view"
                    tools:text="DE (80.158.109.4)" />

                <LinearLayout
                    android:id="@+id/dns_summary_ll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/dns_latency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="?attr/primaryLightColorText"
                        android:textSize="@dimen/default_font_text_view"
                        tools:text="65ms" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/dns_unicode_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:paddingStart="6dp"
                        android:singleLine="true"
                        android:textColor="?attr/primaryTextColor"
                        android:textSize="@dimen/default_font_text_view" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/dns_divider"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="?attr/divider" />
</LinearLayout>
