<?xml version="1.0" encoding="utf-8"?>
<!-- Fork (白い熊 考直) — Snooping panel severity badge background. Solid white so it
     can be tinted per-severity at runtime via backgroundTintList. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="6dp" />
    <solid android:color="@android:color/white" />
    <padding
        android:bottom="2dp"
        android:left="6dp"
        android:right="6dp"
        android:top="2dp" />
</shape>
